---
interface Props {
    title?: string;
    description?: string;
}

const site = "Ashwin's Website";
const {title} = Astro.props;
const description =
    Astro.props.description ??
    "Ashwin Naren's personal website covering machine learning reliability, theoretical computer science, projects, writing, and publications.";
---

<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{title ? `${title} | ${site}` : site}</title>
<meta name="description" content={description}/>
<meta name="author" content="Ashwin Naren"/>
<meta name="google-site-verification" content="_hn20JWWlXeedalasaoy7ACcGRHjLTenBH_ozAwUgl0"/>
<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}/>
<link rel="alternate" type="application/rss+xml" title={site} href="/index.xml"/>
<link rel="icon" href="/favicon.ico"/>
<link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
<link rel="manifest" href="/site.webmanifest"/>
<style is:inline>
    :root {
        color-scheme: light dark;
    }

    body {
        color: #444;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        font-size: 16px;
        line-height: 1.8;
    }

    a {
        color: inherit;
        text-decoration: none;
        border-bottom: 1px solid;
    }

    a:hover {
        border-bottom: 0;
    }

    @media (prefers-color-scheme: dark) {
        body {
            color: #ccc;
        }
    }
</style>
